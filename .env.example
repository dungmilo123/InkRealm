# =============================================================================
# InkRealm Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# .env.local can override .env for personal overrides.
#
# Dev setup:
#   1. Create a Neon dev branch:  npx neonctl branches create --name dev --parent production
#   2. Create an R2 dev bucket:   novel-storage-dev (in Cloudflare dashboard)
#   3. Copy this file to .env and fill in dev branch connection strings
#
# Prod setup (Railway):
#   All env vars are set in Railway dashboard — never put prod secrets in .env

# --- Database (Neon) ---
# Pooled connection — for app runtime (has -pooler in hostname)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection — for Prisma CLI migrations (no -pooler)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="change-me-generate-with-npx-auth-secret"
# Google OAuth credentials from Google Cloud Console
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# --- Translation ---
# Generate with: openssl rand -base64 32
TRANSLATION_ENCRYPTION_SECRET="your-secure-encryption-secret-here"

# --- Email (Resend) ---
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Cloudflare R2 Storage ---
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="novel-storage-dev"

# --- Translation Queue (Upstash Redis + BullMQ) ---
# Get from Upstash Console > Redis Database > Connect > ioredis
# Must start with redis:// or rediss://
UPSTASH_REDIS_URL="rediss://:password@your-endpoint.upstash.io:6379"
