{
  "$schema": "https://schema.railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npx prisma generate"
  },
  "deploy": {
    "startCommand": "npm run worker",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ALWAYS"
  }
}
