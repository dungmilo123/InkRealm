# PostgreSQL connection string
# Ensure PostgreSQL is running and create a database before running the app
# Pooled connection — for app runtime (has -pooler in hostname)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection — for Prisma CLI migrations (no -pooler)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Encryption secret for translation API keys (required for translation feature)
# Generate a secure key with: openssl rand -base64 32
TRANSLATION_ENCRYPTION_SECRET="your-secure-encryption-secret-here"

# Auth.js configuration (required for authentication)
# Generate with: npx auth secret
AUTH_SECRET="change-me-generate-with-npx-auth-secret"
# Google OAuth credentials from Google Cloud Console
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Resend configuration (required for password reset emails)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
