// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TranslationProvider {
  OPENAI
  ANTHROPIC
  DEEPSEEK
  OPENROUTER
  MINIMAX
}

enum TranslationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ChapterTranslationStatus {
  PENDING
  TRANSLATING
  TRANSLATED
  FAILED
}

enum GlossaryEntryType {
  CHARACTER
  PLACE
  TECHNIQUE
  OTHER
}

enum GlossaryEntryStatus {
  CONFIRMED
  PENDING
}

enum ReaderTheme {
  LIGHT
  DARK
  SEPIA
}

enum ReaderFontFamily {
  SANS
  SERIF
}

enum ReaderTextAlign {
  LEFT
  JUSTIFY
}

enum ReaderParagraphSpacing {
  COMPACT
  NORMAL
  RELAXED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  novels        Novel[]
  translationProfiles TranslationProfile[]
  readingProgress     ReadingProgress[]
  readingPreferences  UserReadingPreferences?
  bookmarks           Bookmark[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Novel {
  id               String   @id @default(cuid())
  title            String
  originalFileName String
  fileType         String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translations          NovelTranslation[]
  translatedChapters    NovelTranslatedChapter[]
  glossaryEntries       NovelGlossaryEntry[]
  chapterCount          Int?
  isPinned              Boolean  @default(false)
  pinnedAt              DateTime?
  readingProgress       ReadingProgress[]
  bookmarks             Bookmark[]

  @@index([userId, createdAt])
}

model TranslationProfile {
  id              String              @id @default(cuid())
  provider        TranslationProvider
  model           String
  baseUrl         String?
  encryptedApiKey String
  customPrompt    String?
  isDefault       Boolean             @default(false)
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, model, userId])
}

model NovelTranslation {
  id                String                  @id @default(cuid())
  novelId           String
  targetLanguage    String
  providerSnapshot  TranslationProvider
  modelSnapshot     String
  status            TranslationStatus       @default(PENDING)
  totalChapters     Int                     @default(0)
  completedChapters Int                     @default(0)
  failedChapterIndex Int?
  failureReason     String?
  exportPath        String?
  contextChapters   Int                     @default(0)
  contextSummaries  Int                     @default(0)
  useGlossary       Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  novel                    Novel                   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters                 NovelTranslationChapter[]
  translatedChapterRecords NovelTranslatedChapter[]

  @@index([novelId])
  @@index([novelId, status])
}

model NovelTranslationChapter {
  id               String                 @id @default(cuid())
  translationId    String
  chapterIndex     Int
  status           ChapterTranslationStatus @default(PENDING)
  originalTitle    String
  translatedTitle  String?
  translatedContent String?
  summary          String?
  errorMessage     String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  translation      NovelTranslation       @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([translationId, chapterIndex])
  @@index([translationId, status])
}

model NovelGlossaryEntry {
  id        String             @id @default(cuid())
  novelId   String
  canonical String
  type      GlossaryEntryType  @default(OTHER)
  status    GlossaryEntryStatus @default(CONFIRMED)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  novel     Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  variants  NovelGlossaryVariant[]

  @@index([novelId, status])
}

model NovelGlossaryVariant {
  id      String             @id @default(cuid())
  entryId String
  variant String
  entry   NovelGlossaryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

model ReadingProgress {
  id               String         @id @default(cuid())
  userId           String
  novelId          String
  lastChapterIndex Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel            Novel          @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapterVisits    ChapterVisit[]

  @@unique([userId, novelId])
}

model ChapterVisit {
  id                String          @id @default(cuid())
  readingProgressId String
  chapterIndex      Int
  scrollPosition    Float?
  visitedAt         DateTime        @default(now())
  readingProgress   ReadingProgress @relation(fields: [readingProgressId], references: [id], onDelete: Cascade)

  @@unique([readingProgressId, chapterIndex])
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  novelId      String
  chapterIndex Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel        Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId, chapterIndex])
  @@index([userId, novelId])
}

model UserReadingPreferences {
  id               String                @id @default(cuid())
  userId           String                @unique
  fontSize         Int                   @default(18)
  lineHeight       Float                 @default(1.75)
  theme            ReaderTheme           @default(LIGHT)
  fontFamily       ReaderFontFamily      @default(SERIF)
  maxWidth         Int                   @default(720)
  textAlign        ReaderTextAlign       @default(LEFT)
  paragraphSpacing ReaderParagraphSpacing @default(NORMAL)
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NovelTranslatedChapter {
  id                String           @id @default(cuid())
  novelId           String
  chapterIndex      Int
  translatedTitle   String
  translatedContent String
  summary           String?
  translationId     String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  novel             Novel            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  translation       NovelTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([novelId, chapterIndex])
  @@index([novelId])
}
